rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(userId) { return signedIn() && request.auth.uid == userId; }
    // Betreiber: dieselben Konten wie SITE.owners und SITE.ownerMails in js/config.js
    // (bestätigte E-Mail-Adresse, hinterlegt als SHA-256-Prüfsumme)
    function admin() {
      return signedIn() && (request.auth.uid in ['nxsRHSRqofXDVi6cmYhZXTr3csq1']
        || (request.auth.token.email_verified == true
          && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in [
            'f8a5c29ce669607b870a6bc7a3bebfabae03515d0efbb5d48c9a7ad69be1f268',
            '941589d9f0ffe173319979b71000b2c6c8563d1e3dcc1d995fa22724dff304e5']));
    }

    // Jede Person darf nur ihr eigenes Portfolio lesen und schreiben; Betreiber dürfen es für die Nutzerübersicht lesen
    match /portfolios/{userId} {
      allow read: if own(userId) || admin();
      allow write: if own(userId);
    }
    // Nutzung für die Betreiber-Übersicht: schreibt jede Person nur für sich, lesen dürfen sie und die Betreiber
    match /users/{userId} {
      allow read: if own(userId) || admin();
      allow create, update: if own(userId) && request.resource.data.keys().hasOnly(['email', 'name', 'provider', 'created', 'firstSeen', 'lastSeen',
        'lastPage', 'lang', 'currency', 'device', 'access', 'accessUntil', 'recent', 'visits', 'pages', 'coins', 'source']);
      allow delete: if own(userId);
    }
    // Abo-Stand (status, plan, until, cancel): lesen darf die Person selbst und der Betreiber. Geschrieben wird er ausschließlich
    // vom Zahlungsweg über die Verwaltungs-Schnittstelle, nie aus dem Browser.
    match /subscriptions/{userId} {
      allow read: if own(userId) || admin();
      allow write: if false;
    }

    // Anonyme Besuche (js/visits.js), auch ohne Konto: Jeder Browser schreibt nur seinen laufenden Besuch, mit festen Feldern und
    // einem Zeitstempel nahe der Serverzeit. Lesen und löschen (nach 30 Tagen) dürfen nur die Betreiber.
    function visitOk() {
      let d = request.resource.data;
      let now = request.time.toMillis();
      return d.keys().hasOnly(['day', 'start', 'last', 'dur', 'n', 'pages', 'land', 'ev', 'acc', 'dev', 'os', 'br', 'src', 'ref', 'tz', 'loc',
          'lang', 'cur', 'ret', 'pwa'])
        && d.start is int && d.last is int && d.last > now - 600000 && d.last < now + 600000 && d.start <= d.last
        && d.pages is list && d.pages.size() <= 40 && d.ev is map && d.ev.size() <= 30;
    }
    match /visits/{visitId} {
      allow read, delete: if admin();
      allow create: if visitId.matches('^[a-z0-9]{12,24}$') && visitOk();
      allow update: if visitOk() && request.resource.data.start == resource.data.start && request.resource.data.day == resource.data.day;
    }
    // Tagessummen der Besuche: nur bekannte Felder hochzählen; lesen nur die Betreiber
    match /stats/{day} {
      allow read, delete: if admin();
      allow create, update: if day.matches('^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$')
        && request.resource.data.keys().hasOnly(['v', 'one', 'pv', 'secs', 'acc', 'ret', 'pwa', 'dev', 'os', 'br', 'src', 'ref', 'hour', 'tz', 'loc',
          'lang', 'cur', 'land', 'pages', 'coins', 'ev']);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jede Person darf nur ihr eigenes Portfolio lesen und schreiben
    match /portfolios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Abo-Stand (status, plan, until, cancel): lesen darf nur die Person selbst. Geschrieben wird er ausschließlich vom Zahlungsweg
    // über die Verwaltungs-Schnittstelle, nie aus dem Browser.
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
